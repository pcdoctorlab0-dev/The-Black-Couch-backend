# Second layer of defense (the storage dir is already outside any place PHP
# is configured to execute from). If this directory is ever exposed under a
# webroot by misconfiguration, this still blocks script execution and listing.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

php_flag engine off
Options -Indexes -ExecCGI
AddHandler cgi-script .php .php3 .php4 .php5 .phtml .pl .py .cgi
