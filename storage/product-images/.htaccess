Options -Indexes -ExecCGI

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
