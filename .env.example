DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=black_couch
DB_USER=black_couch_app
DB_PASS=change_me

# Set to "true" once you switch to a hosted database (TiDB Cloud, PlanetScale,
# RDS, DigitalOcean Managed MySQL, Railway, etc.) — nearly all require TLS.
DB_SSL=false
# Path to the provider's CA bundle. TiDB Cloud's serverless tier terminates
# TLS with a public CA (DigiCert Global Root), which is already trusted by
# most systems' default CA store — so this can usually stay blank even with
# DB_SSL=true. Only set it if you hit an SSL verification error.
DB_SSL_CA=

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174
CLOUDINARY_CLOUD_NAME=your-cloud-name
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=replace-with-a-new-rotated-private-key
EMAILJS_OTP_TEMPLATE_ID=your-otp-template-id
EMAILJS_RESET_TEMPLATE_ID=your-password-reset-template-id
EMAILJS_INITIAL_REMAINING=200
EMAILJS_CYCLE_LIMIT=200
EMAILJS_RESET_AT=2026-10-17T00:00:00+02:00
PASSWORD_RESET_DELIVERY=log
# Optional; defaults to the system temp directory, outside the web root.
PASSWORD_RESET_LOG_PATH=

# --- Example: TiDB Cloud Serverless values, parsed from your connection string ---
# DATABASE_URL: mysql://<user>.root:<password>@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/black_couch
#
# DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=black_couch
# DB_USER=<your-cluster-prefix>.root
# DB_PASS=<your-rotated-password>
# DB_SSL=true
